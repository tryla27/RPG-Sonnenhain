[Unit]
Description=Sonnenhain dedicated Godot server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/sonnenhain-server/releases/current
ExecStart=%h/sonnenhain-server/releases/current/sonnenhain-server.x86_64 --headless -- --dedicated-server
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
